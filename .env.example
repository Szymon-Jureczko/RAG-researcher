# ─────────────────────────────────────────────
# Research Paper RAG - Environment Variables
# Copy to .env and fill in your values.
# ─────────────────────────────────────────────

# OpenAI (or compatible) API key for LLM generation
OPENAI_API_KEY=

# Anthropic API key – required only when llm.research.model_name is set to "claude-*"
ANTHROPIC_API_KEY=

# Weaviate (production hybrid search) – leave blank for local FAISS-only mode
WEAVIATE_URL=
WEAVIATE_API_KEY=

# HuggingFace token (optional, for gated models)
HUGGINGFACE_TOKEN=

# Local PDF storage directory (overrides config.yaml sources.local.pdf_dir)
PDF_DIR=data/papers/
